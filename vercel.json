{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "project-atlas-api": {
      "root": "backend",
      "entrypoint": "server.js"
    },
    "project-atlas-web": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/server.js" }
  ]
}